# Python
__pycache__/
*.py[cod]
*.egg-info/

# uv / virtualenv
.venv/

# Local caches (HF model/sample cache lives in ~/.cache/huggingface by default)
.cache/
hf_cache/

# OS / editor
.DS_Store
.idea/
# OpenCode codebase index (local, regenerated)
.opencode/
# Generated audio output (make tts, pipeline runs)
*.wav
# Pipeline tee artifact (README Pipeline example writes ./out.txt)
out.txt

# Local HQQ quantized model output (published to Hugging Face, not in git)
whisper-tiny-hqq-4bit/
# Transient WER-sweep model dirs
sweep_*/
# Hugging Face cache dirs downloaded into the repo root
models--*/
# Eval run logs and intermediate local result (canonical results are
# eval_baseline.json / eval_hqq.json, committed as evidence)
eval_*.log
eval_hqq_local.json
# Per-language multilingual eval logs (the .json results are committed)
eval_multilingual/*.log
# Call-center benchmark: commit the .json results, ignore the run logs.
# mu-bench JSON results hold only aggregate metrics (no transcripts), per its
# CC-BY-NC-4.0 license; the audio/transcripts are never committed.
eval_callcenter/*.log
eval_callcenter/run_bench.sh
# Misc lock dirs created during HF downloads
.locks/
